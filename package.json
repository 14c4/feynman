{
  "name": "feynman-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "start:server": "tsx --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "start": "tsx server/index.ts --production"
  },
  "dependencies": {
    "@elevenlabs/react": "^1.17.0",
    "@mediapipe/tasks-vision": "0.10.35",
    "@smartspectra/node-sdk": "^3.4.0",
    "@supabase/supabase-js": "^2.117.3",
    "jpeg-js": "0.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.13.0",
    "tsx": "^4.23.15",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4"
  }
}
