# Hosting. `npm start` serves dist/ and /api together and binds 0.0.0.0 in production.
PORT=
HOST=
# Behind a reverse proxy (Railway): use X-Forwarded-For for per-client rate limits.
# TRUST_PROXY=true
# Abuse protection (defaults shown). RATE_LIMIT is on in production; set off to disable, on to force locally.
# RATE_LIMIT=on
# MAX_SESSIONS=500
# SESSION_TTL_HOURS=24
# MAX_MONITORING_WINDOWS=4
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional: set GEMINI_THINKING=off if your model rejects thinking settings (the API also falls back automatically).
# Optional cost estimates in GET /api/metrics (USD per million tokens) and your known daily request quota.
# GEMINI_PRICE_INPUT_PER_M=0.30
# GEMINI_PRICE_OUTPUT_PER_M=2.50
# GEMINI_DAILY_REQUEST_LIMIT=20
# METRICS_ENABLED=true   # /api/metrics is off in production unless set
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Optional accounts (Supabase). Run supabase/schema.sql once, then set these.
# VITE_ values are public by design (browser sign-in). SUPABASE_SECRET_KEY is server-only: never prefix it with VITE_.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=

# Optional camera insights (Presage SmartSpectra). Leave empty to disable.
PRESAGE_API_KEY=
# presage (default) | simulated (development/test only; synthetic, labeled readings, no camera)
# PHYSIOLOGY_SOURCE=presage
# Experimental: pulse-only Presage graph (may not need the chest in view; undocumented by Presage).
# PRESAGE_METRICS=pulse

# Explicit local-only fixtures. Leave mode real for normal provider adapters.
PRACTICE_PROVIDER_MODE=real
# Mock mode also requires NODE_ENV=development (or test); production rejects it.
# NODE_ENV=development
# PRACTICE_PROVIDER_MODE=mock
# MOCK_PROVIDER_SCENARIO=normal
# Scenarios: normal, clarification, prepare-error-once, grade-error-once
# MOCK_PROVIDER_DELAY_MS=350
