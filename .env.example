PORT=
HOST=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Optional camera insights (Presage SmartSpectra). Leave empty to disable.
PRESAGE_API_KEY=
# presage (default) | simulated (development/test only; synthetic, labeled readings, no camera)
# PHYSIOLOGY_SOURCE=presage

# Explicit local-only fixtures. Leave mode real for normal provider adapters.
PRACTICE_PROVIDER_MODE=real
# Mock mode also requires NODE_ENV=development (or test); production rejects it.
# NODE_ENV=development
# PRACTICE_PROVIDER_MODE=mock
# MOCK_PROVIDER_SCENARIO=normal
# Scenarios: normal, clarification, prepare-error-once, grade-error-once
# MOCK_PROVIDER_DELAY_MS=350
